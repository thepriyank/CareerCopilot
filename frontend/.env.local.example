NEXT_PUBLIC_API_URL=http://localhost:3001

# Google sign-in (Firebase) — 2026-09-07. All four are the PUBLIC values
# from Firebase Console → Project Settings → General → Your apps → Web app
# (safe to expose in client code by design; they identify the project, they
# don't authenticate anything on their own). Leave unset and the "Continue
# with Google" button simply doesn't render — see lib/firebase.ts.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Assisted Apply extension — the Chrome extension's own id (chrome://extensions,
# with Developer mode on, once it's loaded unpacked or published). Used by
# /extension/connect to hand off a freshly minted token via
# chrome.runtime.sendMessage(EXTENSION_ID, ...). Left unset, the connect page
# still works — it just falls back to "copy this token into the extension"
# instead of the automatic handoff. See extension/README.md.
# Defaults to the published Chrome Web Store id (src/lib/extension.ts) — only
# set this to point at a locally loaded unpacked build, whose id differs.
NEXT_PUBLIC_EXTENSION_ID=

# Optional override for the extension's Chrome Web Store listing URL. The
# live listing is baked in as the default (src/lib/extension.ts), so leave
# this empty unless you need to point somewhere else. Settings → Extensions,
# the landing footer and /extension/connect all link here — there's no API to
# install an extension inline from a third-party page anymore, so this is a
# real Web Store link the user clicks "Add to Chrome" on. See
# extension/CHROMEWEBSTORE.md.
NEXT_PUBLIC_CHROME_WEBSTORE_URL=
