{
  "name": "@jobmagnate/backend",
  "version": "0.1.0",
  "description": "Jobmagnate – Express + TypeScript API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "verify:seeds": "ts-node src/scripts/verifySeeds.ts",
    "discover:run": "ts-node src/scripts/runDiscovery.ts",
    "discover:run:prod": "node dist/scripts/runDiscovery.js",
    "postinstall": "npx playwright install chromium --with-deps || npx playwright install chromium",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/dataSource.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/dataSource.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/dataSource.ts",
    "migration:run:prod": "typeorm migration:run -d dist/config/dataSource.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google-cloud/storage": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "firebase-admin": "^14.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "openai": "^6.48.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.3",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "docx": "^9.7.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
