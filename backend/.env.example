# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Local dev origin. Production is https://jobmagnate.com — set this to that
# (and to the deployed frontend's own origin for any staging environment).
CORS_ORIGIN=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_career_copilot?schema=public"

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# Google sign-in via Firebase (2026-09-07) — verifies the ID token the
# frontend gets from Firebase Auth after a Google sign-in (see
# services/auth/firebaseAdmin.ts, routes/auth.routes.ts's POST /google).
# Unset FIREBASE_PROJECT_ID → that one endpoint returns a clear "not
# configured" error; password login/register are unaffected either way.
FIREBASE_PROJECT_ID=
# Exactly one of these two, or neither (falls back to Application Default
# Credentials). Same convention as GCS_KEY_FILE — put it under backend/
# secrets/ (gitignored) and reference it relative to the backend/ working
# directory. Get this from Firebase Console → Project Settings → Service
# Accounts → Generate new private key.
FIREBASE_KEY_FILE=
FIREBASE_CREDENTIALS_JSON=

# ─── LLM provider chain ───────────────────────────────────────────────────────
# generate() walks a chain of OpenAI-compatible providers and uses the first
# that answers. A provider is active only when its *_API_KEY below is set. Every
# FREE-tier provider is tried before any PAID one; a provider that hits its rate
# limit / quota is benched for LLM_COOLDOWN_MS, then the chain moves on.
#   Docs:     docs/llm_provider_fallback.md
#   Registry: src/services/ai/providerRegistry.ts  (add a provider here)
#
# Keys are also read from the repo-root .env (this file / backend/.env wins).

# Priority order (csv of provider ids). Unlisted providers fall to the end.
# Free-before-paid is always enforced afterwards, whatever this says.
LLM_PROVIDER_ORDER=groq,cerebras,gemini,ollama,openrouter,deepseek,anthropic,openai

# Cooldown for a rate-limited provider when the response has no Retry-After (ms).
LLM_COOLDOWN_MS=900000

# Paid providers (deepseek, anthropic, openai) are NEVER used unless this is
# truthy. Keeps local dev from spending real money on fallback.
LLM_ALLOW_PAID=false

# ── Free tier ── (set the ones you have; leave the rest blank)
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=              # https://console.groq.com  (gsk_… ; GROK_API_KEY also accepted)
# GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=          # https://cloud.cerebras.ai
# CEREBRAS_MODEL=gpt-oss-120b
OLLAMA_API_KEY=            # https://ollama.com/settings/keys  (Ollama Cloud)
# OLLAMA_MODEL=gpt-oss:20b
OPENROUTER_API_KEY=        # https://openrouter.ai/keys  (":free" models need a one-time $10 credit)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free   (legacy: OPENROUTER_PRESET)

# ── Paid — only used when LLM_ALLOW_PAID=true ──
DEEPSEEK_API_KEY=          # https://platform.deepseek.com  (very cheap, no free tier)
# DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_GENERATION_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=            # https://platform.openai.com/api-keys
# OPENAI_MODEL=gpt-4o-mini

# ─── Settings encryption (optional) ────────────────────────────────────────────
# Encrypts a user's saved model-connection string (Settings → API keys) at
# rest — it may be a real cloud API key. Without this set, that one feature
# returns a clear "not configured" error; nothing else is affected.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=

# ─── Job discovery (optional) ─────────────────────────────────────────────────
# Aggregator APIs used by POST /api/jobs/discover for broad India + remote
# coverage. Each is independent: unset → that provider is skipped, every other
# provider still runs. None are required for the app to work.

# TheirStack (api.theirstack.com) — licensed job-data source.
# Sign up at https://theirstack.com  (free tier: 200 API credits/month — thin
# for a daily refresh; effectively a paid source for real volume).
THEIRSTACK_API_KEY=

# Adzuna (api.adzuna.com) — free job aggregator, India + global. Needs BOTH an
# app_id and an app_key from https://developer.adzuna.com/signup
# Free tier ~250 calls/day, non-commercial.
# DISABLED 2026-09-12 (not wired into aggregatorProviders — see
# providers/index.ts): Adzuna's /search endpoint hard-truncates description
# to 500 chars by design, unusable for skill matching. Setting these does
# nothing until/unless that's revisited.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble (jooble.org) — free job aggregator. Request a key at
# https://jooble.org/api/about  (free; informal rate limits; their terms ask
# for an attribution link back to Jooble on pages that show their results).
JOOBLE_API_KEY=

# JSearch — job aggregator over Google for Jobs' index (itself re-syndicating
# LinkedIn/Indeed/Glassdoor/ZipRecruiter/company boards). Evaluated
# 2026-09-06 against a real pull: good, full descriptions; approved for live
# use. The SAME underlying product is sold two ways — set either or both to
# roughly double the effective free monthly quota (~200 each); only one is
# ever called per search, so there's no duplicate-job/wasted-quota risk from
# configuring both. See jsearch.ts / jobCredentialChain.ts for the rotation.
# (2026-09-06: confirmed live that RapidAPI's old `/search` path 404s now —
# both credentials use `/search-v2` as of this writing.)
#   RapidAPI marketplace: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_RAPID_API_KEY=
#   OpenWeb Ninja direct portal: https://www.openwebninja.com/api/jsearch
JSEARCH_OPEN_WEB_NINJA_API_KEY=

# Shared secret for POST /api/internal/jobs/ingest (middleware/internalAuth.ts)
# — the local JobSpy scraper (scripts/jobspy-ingest/) authenticates with this
# bearer token. Generate your own (e.g. `openssl rand -hex 32`); the route
# rejects every request when this is unset, so there's no "accidentally open"
# state. Never share the same value across machines you don't control.
INTERNAL_INGEST_TOKEN=

# Twice-daily background refresh of the shared job pool — system-internal
# only (2026-09-06 product decision: candidates never trigger discovery
# themselves; there's no HTTP route for it). The cron runs against a
# system-wide target-title list (services/jobs/providers/seeds/target-job-
# titles.json — a stand-in for the admin-configurable list the F4 plan doc
# describes, not yet built). Off by default so local dev/test never burns
# free-tier API quota just by starting the server — turn it on for anything
# resembling real usage, since candidates' job boards populate from this
# pool and stay empty without it. See services/jobs/discoveryCron.ts.
JOB_DISCOVERY_CRON_ENABLED=false
# Standard 5-field cron expression, evaluated in UTC. Default: 1:30 and
# 11:30 UTC = 7:00am / 5:00pm IST.
JOB_DISCOVERY_CRON_SCHEDULE=30 1,11 * * *

# How the shared pool gets filtered into one candidate's job board — see
# services/matching/surfaceJobs.ts. minScoreToSurface (0-100) is the bar a
# pool listing must clear to be worth showing a candidate at all; below it,
# a candidate simply never sees the job (no manual dismiss needed). 32 is
# validated against real data, not a round guess — see config/index.ts's
# comment on why (the lexical scoring tops out far lower than intuition
# suggests, even for a genuinely great match).
JOB_MATCH_MIN_SCORE=32
# How much of the pool one GET /api/jobs call rescans (most recently seen
# first) — bounds cost as the pool grows. See surfaceJobs.ts's scale note.
JOB_MATCH_MAX_LISTINGS_TO_SCORE=500

# ─── File Storage ─────────────────────────────────────────────────────────────
# Local directory for uploaded files (relative to backend root). Only used
# when GCS_BUCKET_NAME below is unset — see services/storage/fileStorage.ts.
UPLOAD_DIR=uploads

# Max file upload size in bytes (default 10 MB)
MAX_FILE_SIZE=10485760

# Google Cloud Storage — set GCS_BUCKET_NAME to switch uploaded-résumé
# storage from local disk to GCS (2026-09-07 architecture hardening: local
# disk silently loses every file on a redeploy on most PaaS, and a second
# backend instance can't see a file the first one saved). Leave unset for
# local dev — local disk behaves exactly as before. Files are still
# encrypted at rest by this app (utils/encryption.ts) either way; GCS never
# sees plaintext.
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
# Exactly one of these two, or neither (falls back to Application Default
# Credentials — e.g. already running on GCP infra, or a local `gcloud auth
# application-default login`):
#   a path to a service-account JSON key file — put it under backend/secrets/
#   (gitignored — see .gitignore) and reference it here relative to the
#   backend/ working directory, e.g. GCS_KEY_FILE=secrets/your-key.json.
#   Never commit a key file, and never place one directly in backend/ where
#   a future `git add .` could sweep it in.
GCS_KEY_FILE=
#   ...or the same key's JSON inlined, for a PaaS target with no persistent
#   filesystem to put a key file on
GCS_CREDENTIALS_JSON=

# ─── Redis (cache + rate limiting) ─────────────────────────────────────────────
# 2026-09-07 architecture hardening: an LLM-response cache (keyed per user
# per exact request content) and a per-user rate limit on every LLM-calling
# route (tailor, cover letter, master-résumé generate/regenerate, LinkedIn
# review) — both degrade to a clean no-op with this unset, same as every
# other optional integration in this file. `docker-compose up -d` starts one
# locally on the default port below.
REDIS_URL=redis://localhost:6379

# How long a cached LLM response is reused before a fresh call is made again.
LLM_CACHE_TTL_SECONDS=3600

# Per-user cap on LLM-calling requests, and the rolling window it resets on.
LLM_RATE_LIMIT_MAX=20
LLM_RATE_LIMIT_WINDOW_SECONDS=3600
