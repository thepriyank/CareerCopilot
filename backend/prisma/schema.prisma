datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  PREMIUM
}

enum FileType {
  PDF
  DOCX
}

enum ParseStatus {
  PROCESSING
  COMPLETED
  FAILED
  REVIEW_NEEDED
}

enum RemotePreference {
  REMOTE
  HYBRID
  ONSITE
  OPEN
}

enum SearchUrgency {
  ACTIVELY_LOOKING
  OPEN_TO_OPPORTUNITIES
  NOT_LOOKING
}

enum ArtifactStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ArtifactType {
  RESUME_VERSION
  COVER_LETTER
}

enum ResumeVersionType {
  ORIGINAL
  MASTER
  TAILORED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String                   @id @default(uuid())
  email             String                   @unique
  passwordHash      String
  name              String?
  region            String?
  plan              Plan                     @default(FREE)
  settings          Json                     @default("{}")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  resumeFiles       ResumeFile[]
  parsedResumes     ParsedResume[]
  candidateProfile  CandidateProfile?
  jobPostings       JobPosting[]
  matchResults      MatchResult[]
  generatedResumes  GeneratedResumeVersion[]
  generatedLetters  GeneratedCoverLetter[]
  approvalRecords   ApprovalRecord[]
  skillGapReports   SkillGapReport[]
  linkedInReviews   LinkedInReviewReport[]
  modelUsageRecords ModelUsageRecord[]
}

model ResumeFile {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileType     FileType
  fileName     String
  fileSize     Int
  uploadedAt   DateTime     @default(now())
  parsedResume ParsedResume?
}

model ParsedResume {
  id                String                   @id @default(uuid())
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFileId      String                   @unique
  sourceFile        ResumeFile               @relation(fields: [sourceFileId], references: [id])
  sections          Json                     @default("[]")
  extractedEntities Json                     @default("{}")
  confidenceScores  Json                     @default("{}")
  rawText           String?                  @db.Text
  status            ParseStatus              @default(PROCESSING)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  generatedResumes GeneratedResumeVersion[]
}

model CandidateProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRoles      String[]         @default([])
  industries       String[]         @default([])
  locations        String[]         @default([])
  remotePreference RemotePreference @default(OPEN)
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String           @default("USD")
  urgency          SearchUrgency    @default(ACTIVELY_LOOKING)
  noticePeriod     String?
  visaStatus       String?
  summary          String?
  completionScore  Int              @default(0)
  onboardingState  String           @default("WELCOME")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model JobPosting {
  id               String                   @id @default(uuid())
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source           String                   @default("pasted")
  url              String?
  title            String
  company          String?
  location         String?
  salary           String?
  description      String                   @db.Text
  normalizedFields Json                     @default("{}")
  skills           String[]                 @default([])
  experienceLevel  String?
  isRemote         Boolean?
  createdAt        DateTime                 @default(now())

  matchResults     MatchResult[]
  generatedResumes GeneratedResumeVersion[]
  generatedLetters GeneratedCoverLetter[]
}

model MatchResult {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score     Float
  rationale Json       @default("{}")
  gaps      Json       @default("[]")
  createdAt DateTime   @default(now())
}

model GeneratedResumeVersion {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String?
  job            JobPosting?       @relation(fields: [jobId], references: [id])
  sourceResumeId String?
  source         ParsedResume?     @relation(fields: [sourceResumeId], references: [id])
  content        Json
  provenance     Json              @default("{}")
  diffFromId     String?
  type           ResumeVersionType @default(MASTER)
  status         ArtifactStatus    @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  approvalRecords ApprovalRecord[]
}

model GeneratedCoverLetter {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String
  job        JobPosting     @relation(fields: [jobId], references: [id])
  content    Json
  provenance Json           @default("{}")
  status     ArtifactStatus @default(DRAFT)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  approvalRecords ApprovalRecord[]
}

// Polymorphic approval record: one of resumeVersionId or coverLetterId is set.
model ApprovalRecord {
  id              String                  @id @default(uuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifactType    ArtifactType
  status          ArtifactStatus
  notes           String?
  timestamp       DateTime                @default(now())
  resumeVersionId String?
  resumeVersion   GeneratedResumeVersion? @relation(fields: [resumeVersionId], references: [id])
  coverLetterId   String?
  coverLetter     GeneratedCoverLetter?   @relation(fields: [coverLetterId], references: [id])
}

model SkillGapReport {
  id                    String                 @id @default(uuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleContext           String?
  missingSkills         Json                   @default("[]")
  priorityRanking       Json                   @default("[]")
  createdAt             DateTime               @default(now())

  courseRecommendations CourseRecommendation[]
}

model CourseRecommendation {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillGapId String
  skillGap   SkillGapReport @relation(fields: [skillGapId], references: [id])
  provider   String
  title      String
  url        String
  metadata   Json           @default("{}")
  createdAt  DateTime       @default(now())
}

model LinkedInReviewReport {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections     Json     @default("{}")
  suggestions  Json     @default("{}")
  overallScore Int?
  createdAt    DateTime @default(now())
}

model ModelUsageRecord {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelName    String
  apiKeySource String
  tokensUsed   Int
  costEstimate Float?
  feature      String?
  createdAt    DateTime @default(now())
}
