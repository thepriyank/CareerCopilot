# Copy this to .env in this same directory and fill in real values.
# Never commit the real .env — it's already covered by the repo root
# .gitignore's blanket ".env" rule.

# Where the backend's internal ingest route is reachable from THIS machine.
# Local dev (script + backend on the same machine): http://localhost:3001
# A different machine: point this at wherever the backend actually runs
# (a tunnel, a LAN address, or the deployed URL) — this script never assumes
# it's colocated with the backend.
BACKEND_INGEST_URL=http://localhost:3001/api/internal/jobs/ingest

# Must match backend/.env's INTERNAL_INGEST_TOKEN on whichever machine is
# running the backend this script is posting to. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_INGEST_TOKEN=

# Optional tuning — sensible defaults are baked in if you leave these unset.
# JOBSPY_SITES=indeed,naukri
# JOBSPY_RESULTS_PER_SEARCH=30
# JOBSPY_HOURS_OLD=24
# JOBSPY_SLEEP_SECONDS=8
