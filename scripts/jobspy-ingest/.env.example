# Copy this to .env in this same directory and fill in real values.
# Never commit the real .env — it's already covered by the repo root
# .gitignore's blanket ".env" rule.

# Where the backend's internal ingest route is reachable from THIS machine.
# Local dev (script + backend on the same machine): http://localhost:3001
# A different machine: point this at wherever the backend actually runs
# (a tunnel, a LAN address, or the deployed URL) — this script never assumes
# it's colocated with the backend.
#
# To target the Neon STAGING database: point this at the deployed staging
# backend instead (it's already wired to Neon's `staging` branch) —
# BACKEND_INGEST_URL=https://jobmagnate-backend-staging-w4642vyi6a-as.a.run.app/api/internal/jobs/ingest
BACKEND_INGEST_URL=http://localhost:3001/api/internal/jobs/ingest

# Must match backend/.env's INTERNAL_INGEST_TOKEN on whichever machine is
# running the backend this script is posting to. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# For staging, use the staging token instead (Secret Manager secret
# jobmagnate-staging-internal-ingest-token):
#   gcloud secrets versions access latest --secret=jobmagnate-staging-internal-ingest-token --project=jobmagnet-6a1ab
INTERNAL_INGEST_TOKEN=

# Optional tuning — sensible defaults are baked in if you leave these unset.
# 2026-09-22: defaults to indeed,linkedin only — every other JobSpy site was
# tried live and confirmed broken/blocked (see README "Site selection").
# JOBSPY_SITES=indeed,linkedin
# JOBSPY_RESULTS_PER_SEARCH=300
# JOBSPY_LINKEDIN_RESULTS_PER_SEARCH=100
# JOBSPY_HOURS_OLD=24
# JOBSPY_SLEEP_SECONDS=8
# JOBSPY_LINKEDIN_SLEEP_SECONDS=35
# JOBSPY_MAX_RETRIES=3
# JOBSPY_RETRY_BACKOFF_SECONDS=45
