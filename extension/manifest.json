{
  "manifest_version": 3,
  "name": "JobMagnate — Assisted Apply",
  "version": "0.1.1",
  "description": "Fills job application forms with your JobMagnate profile. You review and click submit — it never does.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobMagnate",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "https://jobmagnate.com/*"]
  }
}
